+// Invoke the signal disposition Sentry replaced. PlxNative installs an
+// async-signal-safe bounded tracer first, so every crash leaves a local
+// PC/register record even if the daemon reaches DONE after failing to write
+// its envelope. The next healthy boot imports the native envelope first and
+// consumes a matching local record by build ID + signal, preserving one
+// Sentry event per process death.
+static void
+chain_previous_handler(int signum, siginfo_t *info, void *context)
+{
+    for (size_t i = 0; i < g_crash_signal_count; i++) {
+        if (g_crash_signals[i] != signum) {
+            continue;
+        }
+        struct sigaction *previous = &g_previous_handlers[i];
+        if (previous->sa_handler == SIG_DFL
+            || previous->sa_handler == SIG_IGN) {
+            return;
+        }
+        if ((previous->sa_flags & SA_SIGINFO) != 0) {
+            previous->sa_sigaction(signum, info, context);
+        } else if (previous->sa_handler) {
+            previous->sa_handler(signum);
+        }
+        return;
+    }
+}
 
