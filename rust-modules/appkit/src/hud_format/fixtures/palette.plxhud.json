{
  "$schema": "https://plxnative.com/hud/schema/1.0.json",
  "format": "1.0",
  "id": "com.plxnative.examples.palette",
  "version": "1.0.0",
  "name": "Palette",
  "author": "PlxNative",
  "license": "CC0-1.0",
  "palette": { "ember": "#ff6a3d", "sand": "#e9d8b4" },
  "layout": {
    "anchor": "bottom",
    "inset": "MD",
    "x_inset": "LG",
    "band": "controls",
    "sections": "modal",
    "block": [
      { "id": "title", "cells": [
        { "align": "start", "text": { "bind": "title.main", "size": "TITLE", "bold": true, "max_lines": 1, "w": "fill",
          "ink": { "value": "sand", "if": { "transport.paused": "ember" } } } }
      ] },
      { "id": "bar", "gap_before": "SM", "cells": [
        { "align": "start", "playbar": { "w": "fill", "fill": "ember", "track": "RAIL_TRACK", "thickness": 6, "clock_size": "CAPTION" } }
      ] },
      { "id": "row", "gap_before": "SM", "cells": [
        { "align": "end", "segment": { "id": "right", "items": [
          { "id": "more", "command": "open_more", "widget": "disc", "size": 52 }
        ] } }
      ] }
    ],
    "up_next": {
      "replaces": [ "right" ],
      "band": "row",
      "align": "end",
      "still": false,
      "caption": false,
      "watch_credits": {},
      "play_next": {},
      "countdown": "fill_sweep"
    }
  }
}
