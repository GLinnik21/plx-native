{
  "version": 1,
  "_comment": "On-device regression matrix for the webOS Plex player. Each case drives the app headless via /tmp/poc-* triggers (see README) and asserts on /tmp/poc-events.log. rks are real PMS items (192.168.0.3:32400). The runner (run.py) reads the X-Plex-Token from src/config.local.h at runtime — it is NEVER stored here. Cases are derived from the library survey; see library_gaps for combos no real item can cover.",
  "pms": { "host": "192.168.0.3", "port": 32400 },
  "tv": "192.168.0.114",

  "cases": [
    {
      "name": "substance_h264_ac3",
      "rk": "4",
      "kind": "movie",
      "title": "The Substance",
      "covers": ["h264+ac3", "directplay-1080p", "embedded-srt"],
      "run_secs": 60,
      "operations": [ { "op": "play" } ],
      "expect": {
        "decision": "directplay",
        "codec_id": 28,
        "min_video_width": 1900,
        "min_timeline_climb_s": 15,
        "no_playing_error": true,
        "require_video_bound": true
      }
    },
    {
