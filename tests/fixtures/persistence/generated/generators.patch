+        "server":{"name":"Server A","machine_id":"aaaa1111","address":"192.0.2.10","port":32400,"token":"synthetic-server-token"},
+        "user":{"id":7,"uuid":"u-7","title":"Profile A","thumb":"","token":"synthetic-user-token"},
