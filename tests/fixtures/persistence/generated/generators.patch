+                      {"id":8,"uuid":"u-8","title":"Profile B","thumb":"","protected":true,"admin":false}],
+        "sources":[{"machine_id":"aaaa1111","name":"Server A","shared_by":"","owned":true,"address":"192.0.2.10","port":32400,"token":"synthetic-server-token"},
+                   {"machine_id":"bbbb2222","name":"Server B","shared_by":"Friend","owned":false,"address":"198.51.100.9","port":31234,"token":"synthetic-share-token"}],
+        "home_pins":[{"user":"u-7","asked":true,"on":[{"machine_id":"bbbb2222","key":1}],"off":[{"machine_id":"aaaa1111","key":2}]}],
+        "recent_searches":[{"user":"u-7","terms":["alpha","beta"]}],
+        "playback_quality":"1080p_8_mbps"}"#;
+
+    #[test]
+    fn emit() {
+        let Ok(out) = std::env::var("PLX_FIXTURE_OUT") else { return };
+        let out = std::path::PathBuf::from(out);
+        let _g = crate::testlock::serial();
+        for (name, errors) in [("v0.6.0-errors-yes.consent.json", true), ("v0.6.0-no.consent.json", false)] {
+            let p = out.join(name);
+            let _ = std::fs::remove_file(&p);
+            super::redirect_for_test(Some(p.clone()));
+            let c = super::consent::apply(&super::Consent::default(), errors, false, || Some(ERR_ID.to_string()));
+            super::record(c);
+            assert!(p.exists(), "{name}");
+        }
+        super::redirect_for_test(None);
+        let sp = out.join("v0.6.0.session.json");
+        let _ = std::fs::remove_file(&sp);
+        crate::plex::session::redirect_for_test(Some(sp.clone()));
+        let s: crate::plex::session::Session = serde_json::from_str(SESSION).unwrap();
+        crate::plex::session::save(&s);
+        crate::plex::session::redirect_for_test(None);
+        assert!(sp.exists());
+    }
+}
