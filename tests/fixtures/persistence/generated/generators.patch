@@ -876,3 +876,33 @@ mod tests {
         assert!(newer.usage);
     }
 }
+
+#[cfg(test)]
+mod plx_fixture_gen {
+    #[test]
+    fn emit() {
+        let Ok(out) = std::env::var("PLX_FIXTURE_OUT") else { return };
+        let out = std::path::PathBuf::from(out);
+        let _g = crate::testlock::serial();
+        // A 0.6.0 errors-yes file upgraded in place by 0.6.5, which then declines the extension.
+        let p = out.join("v0.6.5-errors-yes-declined-extension.consent.json");
+        std::fs::copy(out.join("v0.6.0-errors-yes.consent.json"), &p).unwrap();
+        let loaded = super::load_from(&[p.clone()]);
+        assert!(loaded.errors && loaded.errors_id.is_some());
+        let next = super::consent::apply_extension(&loaded, super::consent::Category::Errors, false, || None);
+        super::redirect_for_test(Some(p.clone()));
+        super::record(next);
+        // A fresh 0.6.5 both-yes answer.
+        let q = out.join("v0.6.5-both-yes.consent.json");
+        let _ = std::fs::remove_file(&q);
+        super::redirect_for_test(Some(q.clone()));
+        let mut n = 0;
+        let c = super::consent::apply(&super::Consent::default(), true, true, || {
+            n += 1;
+            Some(format!("{n:0>32}"))
+        });
+        super::record(c);
+        super::redirect_for_test(None);
+        assert!(q.exists());
+    }
+}
