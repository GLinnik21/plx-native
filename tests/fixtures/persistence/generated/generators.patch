+// Fixture generator only: mount the shipping helper backend into the lib test build (as 0.7 does).
+#[cfg(test)]
+#[path = "../storage_service/backend.rs"]
+pub(crate) mod backend;
+#[cfg(test)]
+#[path = "../storage_service/keymanager.rs"]
+pub(crate) mod keymanager;
+
+#[cfg(test)]
+mod plx_fixture_gen {
+    use super::state::{self, CanonicalState, Expected, Generation};
+    use super::wire::{self, *};
+    use serde_json::Value;
+
+    fn generation_text(generation: Generation) -> String {
+        generation.0.iter().map(|byte| format!("{byte:02x}")).collect()
+    }
+
+    fn wire_expectation(expected: Option<(&str, Expected)>) -> Expectation {
+        match expected {
+            None => Expectation::Missing {},
+            Some((db_rev, expected)) => Expectation::Present {
+                db_rev: db_rev.to_string(),
+                epoch: expected.epoch.to_string(),
+                auth_generation: generation_text(expected.auth_generation),
+            },
+        }
+    }
+
+    #[derive(Default)]
+    struct Db8 {
+        record: Option<Value>,
+        puts: usize,
+    }
+    impl crate::storage::keymanager::Rpc for Db8 {
+        fn call(&mut self, uri: &str, payload: &Value) -> Result<Value, ErrorCode> {
+            match uri {
+                "luna://com.palm.db/get" => Ok(serde_json::json!({"returnValue":true,"results":self.record.iter().cloned().collect::<Vec<_>>()})),
+                "luna://com.palm.db/put" => {
+                    let mut next = payload["objects"][0].clone();
+                    self.puts += 1;
+                    next["_rev"] = serde_json::json!(self.puts);
+                    self.record = Some(next);
+                    Ok(serde_json::json!({"returnValue":true,"results":[{"id":"plxstate.stable","rev":self.puts}]}))
+                }
+                other => panic!("unexpected rpc {other}"),
+            }
+        }
+    }
+
+    fn snapshot(backend: &mut crate::storage::backend::Backend<Db8>) -> Option<(String, Expected)> {
+        match backend.dispatch(Request::Load {}) {
+            Response::Missing => None,
+            Response::Loaded { db_rev, state: value, .. } => {
+                let st = CanonicalState::decode(&serde_json::to_vec(&value).unwrap(), state::Flavor::Stable).unwrap();
+                Some((db_rev, st.expected()))
+            }
+            _ => panic!("load failed"),
+        }
+    }
+
+    fn commit(backend: &mut crate::storage::backend::Backend<Db8>, mutation: WireMutation) {
+        let expected = snapshot(backend);
+        let mut request = Request::Commit {
+            expected: wire_expectation(expected.as_ref().map(|(r, e)| (r.as_str(), *e))),
+            operation_id: generation_text(Generation::random().unwrap()),
+            digest: String::new(),
+            mutation,
+        };
+        let digest = state::digest_bytes(&wire::request_digest_bytes(&request).unwrap());
+        if let Request::Commit { digest: d, .. } = &mut request {
+            *d = digest;
+        }
+        match backend.dispatch(request) {
+            Response::Commit { status: CommitStatus::Committed, applied: Some(_), .. } => {}
+            _ => panic!("commit refused"),
+        }
+    }
+
+    #[test]
+    fn emit() {
+        let Ok(out) = std::env::var("PLX_FIXTURE_OUT") else { return };
+        let out = std::path::PathBuf::from(out);
+        let mut backend = crate::storage::backend::Backend::new(Db8::default(), state::Flavor::Stable, "com.beb.plxnative.storage".into());
+        let session: crate::plex::session::Session =
+            serde_json::from_slice(&std::fs::read(out.join("v0.6.0.session.json")).unwrap()).unwrap();
+        let (public, protected) = crate::plex::session::split_canonical(&session).unwrap();
+        commit(&mut backend, WireMutation::AdvanceMigration {
+            migration: MigrationMutation::SessionComplete {
+                public: serde_json::to_value(&public).unwrap(),
+                auth_plaintext: SecretString(protected),
+                protection: ProtectionRequest::Db8AclOnlyExplicit,
+            },
+        });
+        let consent: crate::telemetry::consent::Consent = serde_json::from_slice(
+            &std::fs::read(out.join("v0.6.5-errors-yes-declined-extension.consent.json")).unwrap(),
+        ).unwrap();
+        let slots = crate::telemetry::consent::split_canonical(&crate::telemetry::consent::migrate_loaded(consent)).unwrap();
+        commit(&mut backend, WireMutation::AdvanceMigration {
+            migration: MigrationMutation::ConsentComplete { consent: serde_json::to_value(slots).unwrap() },
+        });
+        let record = backend.rpc.record.clone().unwrap();
+        std::fs::write(out.join("v0.6.6-db8-record.json"), serde_json::to_vec_pretty(&record).unwrap()).unwrap();
+    }
+}
