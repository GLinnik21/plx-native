{
  "_comment": "The CLOSED ALPHABET every string value in a committed replay fixture must belong to (restructure spec §5.6 rule 2). A value passes if it equals one of `literals` or fully matches one of `patterns`. Recordings are taken against tests/mock_pms.py, whose every name is `s[0-9a-f]{8}`, so no household byte can enter; this file is the allowlist the guard (.claude/hooks/outbound-guard.py) and tests/test_harness.py verify against. A denylist for 'title-shaped' strings is undecidable (diag/scrub.rs's own conclusion), so the rule is an allowlist and a NEW protocol constant is added HERE, by name, in the commit that introduces it.",
  "patterns": [
    "s[0-9a-f]{8}",
    "[0-9]+",
    "[0-9]+\\.[0-9]+\\.[0-9]+(-dev)?",
    "inst:[0-9]+",
    "store:[0-9]+",
    "seed=[0-9]+",
    "plxnative-[a-z]+(=[a-z0-9]+)?",
    "route=[a-z]+( overlay=[a-z]+)?",
    "[A-Z][A-Za-z]+(\\((Instance|Store)\\([0-9]+\\)\\))?",
    "route=[a-z]+ session=[01] servers=[0-9]+ consent=[0-9]+/[01]/[01] seed=[0-9]+",
    "ck:[0-9]+,[0-9]+",
    "pat:[a-z]+(:[0-9.]+)*",
    "txt:(s[0-9a-f]{8}|[0-9a-f+]+)",
    "press phase=(idle|down|up) live=[01] active=[01] long=[01]"
  ],
