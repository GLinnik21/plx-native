# macOS
.DS_Store

# build artifacts
*.o
# stub .so files are generated from stub/*.c by the Makefile
stub/*.so
# cross-compiled binary + packaging output
pkg/plxnative
pkg/*.ipk
pkg/ipk.sha256

# ipk packaging staging (regenerated by `make ipk`)
ipkroot/*.tar.gz
ipkroot/debian-binary
ipkroot/data/usr/

# reference copies of the TV's proprietary shared libs — not needed to build
# (the build links against the stub .so files generated from stub/*.c)
sysroot/

# local dev overrides (real PMS host + X-Plex-Token)
local.env
src/config.local.h
rust-poc/target/
