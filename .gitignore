# macOS
.DS_Store

# build artifacts
*.o
# stub .so files are generated from stub/*.c by the Makefile
stub/*.so
# cross-compiled binary + packaging output
pkg/plxnative
pkg/threadprobe
pkg/*.ipk
pkg/ipk.sha256

# ipk packaging staging (regenerated by `make ipk`)
ipkroot/*.tar.gz
ipkroot/debian-binary
ipkroot/data/usr/

# reference copies of the TV's proprietary shared libs — not needed to build
# (the build links against the stub .so files generated from stub/*.c)
sysroot/

# local dev overrides (real PMS host + X-Plex-Token)
local.env
src/config.local.h
# ...and every agent worktree carries its OWN copy of that file, with the real token in it.
# These were held out of the index by .git/info/exclude, which is local-only: it does not survive
# a clone, is not reviewable, and does not apply in a fresh worktree or a CI checkout. On a repo
# about to go public that is the difference between "ignored" and "one `git add -A` from a live
# credential in history". Belongs here, in the tracked file, where anyone can see it.
.claude/worktrees/
# the on-device suite's installation-specific half: which PMS, which TV, which ratingKeys, which
# Plex Home user. tests/manifest.json keeps the case DEFINITIONS (public); this keeps the private
# library inventory that used to be committed alongside them. See tests/manifest.local.json.example.
tests/manifest.local.json
rust-modules/target/
rust-modules/target-release/

# dead prototype dir (code lives in rust-modules/ now)
rust-poc/
.abi-cache/
.tv-mac
# which television this working copy talks to (Makefile TV, tools/ TV_HOST) — one line, an IP or
# hostname. Local because it is the maintainer's home network, not a project fact.
.tv-host
.tv-stream.pid
.tv-stream.log
pkg/sockprobe

# tv-session.sh --remote: the published URL, the generated password and the tunnel/front-end
# scratch. NEVER commit a password, and never commit a URL that is live while it is live.
.tv-dpad.pid
.tv-dpad.log
.tv-dpad-pass
.tv-tunnel.pid
.tv-tunnel.log
.tv-remote-url
pkg/.build-config
