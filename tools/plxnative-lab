def cmd_start(args) -> int:
    st = _state()
    if st.get("status") == "listening" and st.get("pid") and _alive(st["pid"]):
        print("a session is already listening — one at a time. `plxnative-lab stop` first.",
              file=sys.stderr)
        return 1
    os.makedirs(HOME, exist_ok=True)
    os.chmod(HOME, 0o700)
    shutil.rmtree(UPLOAD_DIR, ignore_errors=True)
    cert, pin = make_cert(HOME, args.hostname)
    session = secrets.token_hex(4)
    st = {
        "session": session,
        "secret": secrets.token_urlsafe(32),
        "hostname": args.hostname,
        "port": args.port,
        "local_port": args.local_port,
        "cert": cert,
        "key": os.path.join(HOME, "key.pem"),
        "pin": pin,
        "no_upnp": bool(args.no_upnp),
        "status": "starting",
        "trigger_wcodes": [int(w) for w in args.trigger.split(",") if w.strip()],
    }
    _write_state(st)
    log = open(SERVER_LOG, "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"],
                     stdout=log, stderr=log, start_new_session=True)
    for _ in range(100):  # up to 10 s for the listener and the port mapping
        time.sleep(0.1)
        st = _state()
        if st.get("status") == "listening":
            break
    if st.get("status") != "listening":
        print("receiver did not come up — see " + SERVER_LOG, file=sys.stderr)
        return 1
    out = {
        "session": st["session"],
        "endpoint": f"{st['hostname']}:{st['port']}",
        "local_port": st["local_port"],
        "upnp": st["upnp"],
        "external_ip": st.get("external_ip"),
        "dns_matches": _dns_matches(st),
        "lab_json": lab_json(st),
        "next": f"make LAB=1 FLAVOR=debug ipk   # stages pkg/lab.json into the package",
    }
    # The file the .ipk carries. Written for you: this is the whole handoff between the two halves
    # of the feature, and hand-copying four fields is how a lab hour gets spent on a 401.
    lab_path = os.path.join(REPO, "pkg", "lab.json")
    os.makedirs(os.path.dirname(lab_path), exist_ok=True)
    with open(lab_path, "w") as f:
        json.dump(json.loads(out["lab_json"]), f, indent=2)
    os.chmod(lab_path, 0o600)
    out["lab_json_path"] = lab_path
    print(json.dumps(out, indent=2) if not args.json else json.dumps(out))
    return 0


def lab_json(st: dict) -> str:
    """Exactly what `pkg/lab.json` must contain — see `rust-modules/src/lab/config.rs`."""
    return json.dumps({
        "endpoint": f"{st['hostname']}:{st['port']}",
        "session": st["session"],
        "secret": st["secret"],
        "pin": st["pin"],
        "trigger_wcodes": st.get("trigger_wcodes", []),
        "trigger_syms": [],
    })


def _dns_matches(st: dict) -> bool | None:
    """Does `lab.plxnative.com` actually resolve to the address the router says it has?

    The one cheap check that the whole path exists BEFORE a tester spends a rented lab hour on it.
    `None` when either half is unknown (no UPnP, no DNS) rather than a confident `False`.
    """
    ext = st.get("external_ip")
    if not ext:
        return None
    try:
        addrs = {a[4][0] for a in socket.getaddrinfo(st["hostname"], None, socket.AF_INET)}
    except socket.gaierror:
        return None
    return ext in addrs


def _uploads() -> list[str]:
    try:
        return sorted(os.path.join(UPLOAD_DIR, f) for f in os.listdir(UPLOAD_DIR)
                      if f.endswith(".jsonl.gz"))
    except OSError:
        return []


def _envelope(path: str) -> dict:
    try:
        with gzip.open(path, "rb") as f:
            return json.loads(f.readline())
    except (OSError, ValueError):
        return {}


def cmd_status(args) -> int:
    st = _state()
    ups = _uploads()
    env = _envelope(ups[-1]) if ups else {}
    dev = env.get("device", {})
    live = bool(st.get("pid") and _alive(st["pid"]))
    age = None
    if ups:
        age = int(time.time() - os.path.getmtime(ups[-1]))
    out = {
        "receiver": "listening" if live and st.get("status") == "listening" else "stopped",
        "endpoint": f"{st.get('hostname', '?')}:{st.get('port', '?')}",
        "session": st.get("session"),
        "upnp": st.get("upnp"),
        "external_ip": st.get("external_ip"),
        "dns_matches": _dns_matches(st),
        "tv": "recent upload" if age is not None and age < 300 else
              ("uploaded" if ups else "not seen"),
        "uploads": len(ups),
        "last_upload_age_s": age,
        "webos": dev.get("webos_release"),
        "board": dev.get("board"),
        "model": dev.get("model"),
        "app_version": (env.get("app") or {}).get("version"),
        "last_route": env.get("route"),
        "dropped": env.get("dropped"),
    }
    if args.json:
        print(json.dumps(out))
    else:
        for k, v in out.items():
            print(f"{k}: {v}")
    return 0


def _since_ms(spec: str | None, env: dict) -> int:
    """`--since 5m` against the RING clock, which is app uptime rather than wall time.

    A record's `t_ms` is milliseconds since the app started, and the envelope's `sent_at_ms` is
    that same clock at the moment of the snapshot — so "the last five minutes" means the five
    minutes of app time before the snapshot, which is what the tester actually means.
    """
    if not spec:
        return -1
    m = re.fullmatch(r"(\d+)([smh])", spec)
    if not m:
        raise SystemExit(f"unparseable --since {spec!r} (try 30s, 5m, 1h)")
    n, unit = int(m.group(1)), m.group(2)
    ms = n * {"s": 1000, "m": 60_000, "h": 3_600_000}[unit]
    return max(0, int(env.get("sent_at_ms", 0)) - ms)


def _emit(path: str, args) -> None:
    env = _envelope(path)
    floor = _since_ms(args.since, env)
    with gzip.open(path, "rb") as f:
        for i, raw in enumerate(f):
            line = raw.decode("utf-8", "replace").rstrip("\n")
            if i == 0 or floor < 0:
                print(line)
                continue
            try:
                if json.loads(line).get("t_ms", 0) >= floor:
                    print(line)
            except ValueError:
                print(line)
    sys.stdout.flush()


def cmd_logs(args) -> int:
    ups = _uploads()
    if args.seq is not None:
        ups = [p for p in ups if str(_envelope(p).get("seq")) == str(args.seq)]
    if not ups and not args.follow:
        print("no uploads yet", file=sys.stderr)
        return 1
    if ups:
        _emit(ups[-1], args)
    if not args.follow:
        return 0
    seen = set(_uploads())
    try:
        while True:
            time.sleep(1.0)
            for p in _uploads():
                if p not in seen:
                    seen.add(p)
                    _emit(p, args)
    except KeyboardInterrupt:
        return 0


def cmd_stop(args) -> int:
    st = _state()
    pid = st.get("pid")
    if pid and _alive(pid):
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            time.sleep(0.1)
            if not _alive(pid):
                break
    st = _state()
    # Verify rather than assume: the whole security argument is that the hole closes with the
    # session, and "we sent a SIGTERM" is not the same statement as "the mapping is gone".
    left = None
    if not st.get("no_upnp"):
        igd = Upnp.discover(timeout=2.0)
        if igd:
            igd.delete(st.get("port", DEFAULT_PORT))
            left = igd.has_mapping(st.get("port", DEFAULT_PORT))
    out = {"receiver": "stopped", "upnp_mapping_remains": left,
           "uploads_kept": len(_uploads()), "uploads_dir": UPLOAD_DIR}
    print(json.dumps(out) if args.json else "\n".join(f"{k}: {v}" for k, v in out.items()))
    return 0


# ---------------------------------------------------------------------------------------------
# selftest — the whole path, on loopback, with no television and no router
# ---------------------------------------------------------------------------------------------


def selftest(_args) -> int:
    fails = []

    def check(name: str, ok: bool, detail: str = "") -> None:
        print(f"{'ok  ' if ok else 'FAIL'} {name}{(' — ' + detail) if detail else ''}")
        if not ok:
            fails.append(name)

    with tempfile.TemporaryDirectory() as tmp:
        cert, pin = make_cert(tmp, "lab.plxnative.com")
        check("certificate + SPKI pin", pin.startswith("sha256//") and len(pin) > 50, pin)
        # the pin is what the app will compare against: recomputing it from the cert must agree
        check("pin is stable", spki_pin(cert) == pin)

        secret = secrets.token_urlsafe(32)
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(cert, os.path.join(tmp, "key.pem"))
        global UPLOAD_DIR
        UPLOAD_DIR = os.path.join(tmp, "uploads")
        srv = Receiver(("127.0.0.1", 0), Handler, secret, "selftest")
        srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
        port = srv.server_address[1]
        threading.Thread(target=srv.serve_forever, daemon=True).start()

        cctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        cctx.check_hostname = False
        cctx.verify_mode = ssl.CERT_NONE

        def post(body: bytes, headers: dict, path: str = "/v1/diag", method: str = "POST"):
            c = http.client.HTTPSConnection("127.0.0.1", port, context=cctx, timeout=5)
            c.request(method, path, body=body, headers=headers)
            r = c.getresponse()
            out = (r.status, r.read())
            c.close()
            return out

        doc = (json.dumps({"kind": "envelope", "seq": 1, "sent_at_ms": 60000,
                           "device": {"webos_release": "10.3.1", "board": "k8hpp"}})
               + "\n" + json.dumps({"t_ms": 59000, "m": "feed v#1 reply=Ok"})).encode()
        gz = gzip.compress(doc)
        good = {"Authorization": "Bearer " + secret, "Content-Type": "application/x-ndjson",
                "Content-Encoding": "gzip", "Content-Length": str(len(gz))}

        st, body = post(gz, good)
        check("a valid gzip upload is accepted", st == 200 and json.loads(body)["ok"], str(st))
        check("it is stored decompressed and readable", len(_uploads()) == 1
              and _envelope(_uploads()[0]).get("seq") == 1)

        time.sleep(MIN_UPLOAD_GAP_S)
        bad = dict(good, Authorization="Bearer wrong")
        st, _ = post(gz, bad)
        check("a wrong secret is refused", st == 401, str(st))

        st, _ = post(gz, dict(good, **{"Content-Length": str(MAX_BODY + 1)}))
        check("an oversized declared body is refused", st == 413, str(st))

        st, _ = post(b"", {"Authorization": "Bearer " + secret, "Content-Length": "0"})
        check("an empty body is refused", st == 413, str(st))

        st, _ = post(gz, good, path="/anything-else")
        check("any other path is 404", st == 404, str(st))

        st, _ = post(b"", {"Content-Length": "0"}, method="GET")
        check("GET is 404 even with no auth", st == 404, str(st))

        time.sleep(MIN_UPLOAD_GAP_S)
        post(gz, good)
        st, _ = post(gz, good)
        check("a second upload inside the gap is rate-limited", st == 429, str(st))

        check("only the accepted uploads were stored", len(_uploads()) == 2, str(len(_uploads())))
        srv.shutdown()

    # UPnP is the one half a selftest cannot fake: report what is on this LAN rather than assert.
    igd = Upnp.discover(timeout=2.0)
    print(f"note  UPnP IGD on this LAN: {'yes — ' + igd.control_url if igd else 'not found'}")
    if igd:
        print(f"note  router says its external address is {igd.external_ip()}")
    print("\n" + ("SELFTEST FAILED: " + ", ".join(fails) if fails else "selftest passed"))
    return 1 if fails else 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    # `--json` is accepted on BOTH sides of the subcommand — `plxnative-lab --json status` and
    # `plxnative-lab status --json`. An agent writes the second one and argparse rejects it unless
    # the flag is on the subparser too, which is a confusing failure for a tool whose whole point
    # is machine-readable output.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--json", action="store_true", dest="json_pre", help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    s = sub.add_parser("start", help="generate a session, listen, and map the port")
    s.add_argument("--hostname", default=DEFAULT_HOST)
    s.add_argument("--port", type=int, default=DEFAULT_PORT, help="the FIXED external port")
    s.add_argument("--local-port", type=int, default=0, help="0 = an ephemeral local port")
    s.add_argument("--no-upnp", action="store_true", help="assume the mapping already exists")
    s.add_argument("--trigger", default="489",
                   help="comma-separated wcodes that fire an upload on the remote. 489 is BLUE, "
                        "measured on the dev set 2026-08-26 (486 RED / 487 GREEN / 488 YELLOW); "
                        "one remote, one firmware — docs/remote-keys.md §9")
    s.set_defaults(fn=cmd_start)

    sub.add_parser("serve", help=argparse.SUPPRESS).set_defaults(fn=serve)

    sub.add_parser("status", help="what the agent polls").set_defaults(fn=cmd_status)

    lg = sub.add_parser("logs", help="print the newest snapshot as JSONL")
    lg.add_argument("--follow", action="store_true")
    lg.add_argument("--since", help="only records within this much APP TIME of the snapshot (5m)")
    lg.add_argument("--seq", help="a specific upload's sequence number")
    lg.set_defaults(fn=cmd_logs)

    sub.add_parser("stop", help="stop listening and remove the mapping").set_defaults(fn=cmd_stop)
    sub.add_parser("selftest", help="prove the receiver on loopback").set_defaults(fn=selftest)

    args = ap.parse_args()
    args.json = args.json or getattr(args, "json_pre", False)
    for opt in ("since", "seq", "follow"):
        if not hasattr(args, opt):
            setattr(args, opt, None)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
