REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
"""The checkout this tool belongs to, so `pkg/lab.json` lands in the tree that will be packaged
rather than wherever the shell happened to be. A lane running in a worktree gets ITS worktree."""

HOME = os.path.expanduser(os.environ.get("PLXNATIVE_LAB_HOME", "~/.plxnative-lab"))
SESSION_FILE = os.path.join(HOME, "session.json")
UPLOAD_DIR = os.path.join(HOME, "uploads")
SERVER_LOG = os.path.join(HOME, "receiver.log")

DEFAULT_HOST = "lab.plxnative.com"
DEFAULT_PORT = 39443
"""The FIXED external port. Fixed so the app needs no discovery: the endpoint is a constant of the
lab build, and the only thing that changes per session is the credential."""

MAX_BODY = 4 * 1024 * 1024
"""Body cap, enforced on the declared Content-Length AND on the bytes actually read. The app's own
ring is capped at 768 KiB of text, which gzips to tens of kilobytes, so this is orders of magnitude
of headroom and still nothing a stranger can use to fill a disk."""
MAX_UPLOADS = 60
MIN_UPLOAD_GAP_S = 2.0
SOCKET_TIMEOUT_S = 20
UPNP_LEASE_S = 3600


def _state() -> dict:
    try:
        with open(SESSION_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def _write_state(d: dict) -> None:
    os.makedirs(HOME, exist_ok=True)
    tmp = SESSION_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.chmod(tmp, 0o600)  # it holds the session secret
    os.replace(tmp, SESSION_FILE)


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


# ---------------------------------------------------------------------------------------------
# TLS: a per-session self-signed certificate, and the SPKI pin the app carries
# ---------------------------------------------------------------------------------------------


def make_cert(dirpath: str, hostname: str) -> tuple[str, str]:
    """Generate `cert.pem` + `key.pem` and return (cert path, `sha256//…` pin).

    Shells out to `openssl`, which is on every macOS and every CI image, rather than adding a
    crypto dependency to a one-file tool. The key never leaves this directory and the directory is
    0700; only the PIN — a hash of the public half — is ever handed to the app.
    """
    cert = os.path.join(dirpath, "cert.pem")
    key = os.path.join(dirpath, "key.pem")
    subprocess.run(
        ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "7",
         "-subj", f"/CN={hostname}", "-addext", f"subjectAltName=DNS:{hostname},IP:127.0.0.1",
         "-keyout", key, "-out", cert],
        check=True, capture_output=True,
    )
    os.chmod(key, 0o600)
    return cert, spki_pin(cert)


def spki_pin(cert_path: str) -> str:
    """The value libcurl's `CURLOPT_PINNEDPUBLICKEY` wants: base64 of SHA-256 over the DER SPKI."""
    pub = subprocess.run(["openssl", "x509", "-pubkey", "-noout", "-in", cert_path],
                         check=True, capture_output=True).stdout
    der = subprocess.run(["openssl", "pkey", "-pubin", "-outform", "der"],
                         input=pub, check=True, capture_output=True).stdout
    return "sha256//" + base64.b64encode(hashlib.sha256(der).digest()).decode()


# ---------------------------------------------------------------------------------------------
# UPnP IGD: a temporary hole, removed on every exit path
# ---------------------------------------------------------------------------------------------

SSDP_ADDR = ("239.255.255.250", 1900)
IGD_TYPES = [
    "urn:schemas-upnp-org:service:WANIPConnection:1",
    "urn:schemas-upnp-org:service:WANIPConnection:2",
    "urn:schemas-upnp-org:service:WANPPPConnection:1",
]


class Upnp:
    """The router's WAN connection service, and the one mapping we own on it.

    Deliberately dumb: discover, add, delete, ask the external address. It holds no state the
    router does not, so a crashed receiver leaves at most one mapping with a one-hour lease rather
    than a permanent hole — which is why `AddPortMapping` asks for a lease at all, and why the
    renewal thread exists to keep it alive only while the process does.
    """

    def __init__(self, control_url: str, service_type: str):
        self.control_url = control_url
        self.service_type = service_type

    @classmethod
    def discover(cls, timeout: float = 3.0) -> "Upnp | None":
        msg = (
            "M-SEARCH * HTTP/1.1\r\n"
            f"HOST: {SSDP_ADDR[0]}:{SSDP_ADDR[1]}\r\n"
            'MAN: "ssdp:discover"\r\n'
            "MX: 2\r\n"
            "ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n\r\n"
        ).encode()
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(timeout)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        locations: list[str] = []
        try:
            s.sendto(msg, SSDP_ADDR)
            deadline = time.time() + timeout
            while time.time() < deadline:
                try:
                    data, _ = s.recvfrom(4096)
                except socket.timeout:
                    break
                m = re.search(rb"(?im)^location:\s*(\S+)", data)
                if m:
                    loc = m.group(1).decode()
                    if loc not in locations:
                        locations.append(loc)
        finally:
            s.close()
        for loc in locations:
            got = cls._from_description(loc)
            if got:
                return got
        return None

    @classmethod
    def _from_description(cls, location: str) -> "Upnp | None":
        try:
            with urllib.request.urlopen(location, timeout=3) as r:
                xml = r.read().decode("utf-8", "replace")
        except Exception:
            return None
        for st in IGD_TYPES:
            # the control URL that belongs to THIS service element, not the first one in the file
            for block in re.findall(r"<service>(.*?)</service>", xml, re.S):
                if st in block:
                    m = re.search(r"<controlURL>(.*?)</controlURL>", block, re.S)
                    if m:
                        return cls(urllib.parse.urljoin(location, m.group(1).strip()), st)
        return None

    def _soap(self, action: str, args: list[tuple[str, str]]) -> str | None:
        body = "".join(f"<{k}>{v}</{k}>" for k, v in args)
        env = (
            '<?xml version="1.0"?>'
            '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
            's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
            f'<s:Body><u:{action} xmlns:u="{self.service_type}">{body}</u:{action}></s:Body>'
            "</s:Envelope>"
        ).encode()
        req = urllib.request.Request(
            self.control_url, data=env,
            headers={"Content-Type": 'text/xml; charset="utf-8"',
                     "SOAPAction": f'"{self.service_type}#{action}"'},
        )
        try:
            with urllib.request.urlopen(req, timeout=5) as r:
                return r.read().decode("utf-8", "replace")
        except Exception:
            return None

    def add(self, external_port: int, internal_ip: str, internal_port: int, lease: int) -> bool:
        args = [
            ("NewRemoteHost", ""), ("NewExternalPort", str(external_port)),
            ("NewProtocol", "TCP"), ("NewInternalPort", str(internal_port)),
            ("NewInternalClient", internal_ip), ("NewEnabled", "1"),
            ("NewPortMappingDescription", "plxnative-lab"), ("NewLeaseDuration", str(lease)),
        ]
        if self._soap("AddPortMapping", args) is not None:
            return True
        # Several IGDs (Keenetic among the forgiving ones, but not all firmware) refuse a non-zero
        # lease on a static mapping. A permanent mapping we delete ourselves is the fallback, not
        # the default: if this process dies hard, a leased mapping expires on its own.
        args[-1] = ("NewLeaseDuration", "0")
        return self._soap("AddPortMapping", args) is not None

    def delete(self, external_port: int) -> bool:
        return self._soap("DeletePortMapping", [
            ("NewRemoteHost", ""), ("NewExternalPort", str(external_port)), ("NewProtocol", "TCP"),
        ]) is not None

    def external_ip(self) -> str | None:
        xml = self._soap("GetExternalIPAddress", [])
        if not xml:
            return None
        m = re.search(r"<NewExternalIPAddress>(.*?)</NewExternalIPAddress>", xml, re.S)
        return m.group(1).strip() if m else None

    def has_mapping(self, external_port: int) -> bool:
        return self._soap("GetSpecificPortMappingEntry", [
            ("NewRemoteHost", ""), ("NewExternalPort", str(external_port)), ("NewProtocol", "TCP"),
        ]) is not None


def lan_ip() -> str:
    """This machine's address on the LAN the router can reach — the `NewInternalClient` value.

    Taken from a connected UDP socket rather than `gethostbyname(gethostname())`, which on macOS
    answers `127.0.0.1` as often as not and would map the router's port to the router's own idea of
    nowhere.
    """
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9))  # TEST-NET-1: routed nowhere, and no packet is sent
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


# ---------------------------------------------------------------------------------------------
# the receiver
# ---------------------------------------------------------------------------------------------


class Receiver(ThreadingHTTPServer):
    daemon_threads = True
    # One tester, one television. The cap is not tuning — it bounds how much a stranger who finds
    # the port can allocate before every thread is busy refusing them.
    request_queue_size = 8

    def __init__(self, addr, handler, secret: str, session: str):
        super().__init__(addr, handler)
        self.secret = secret
        self.session = session
        self.lock = threading.Lock()
        self.uploads = 0
        self.last_at = 0.0
        self.rejected = 0


class Handler(BaseHTTPRequestHandler):
    server_version = "plxnative-lab"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    timeout = SOCKET_TIMEOUT_S

    def log_message(self, fmt, *args):
        """One line per request, to the receiver log, NAMING THE PEER.

        The peer address is not decoration. It is the only thing that distinguishes "the
        television reached me from the internet" from "something on my own LAN reached me because
        the router hairpinned" — a distinction that decides whether a Cloud Test Lab session will
        work at all, and one that cost a round of confusion when this line printed neither.
        """
        sys.stderr.write("%s %s %s\n" % (time.strftime("%H:%M:%S"), self.client_address[0],
                                          fmt % args))
        sys.stderr.flush()

    def _refuse(self, code: int, why: str) -> None:
        """Answer and CLOSE.

        The close is load-bearing rather than tidy: a refusal happens before the request body is
        read (deliberately — an unauthenticated caller must not be able to make this process read
        four megabytes), so the unread body is still in the socket. On a keep-alive connection the
        next parse would start in the middle of it and answer `400 Bad request syntax`, which is
        what the selftest saw before this line existed.
        """
        body = json.dumps({"ok": False, "error": why}).encode()
        self.close_connection = True
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Connection", "close")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        self.server.rejected += 1

    # Everything that is not the one route is a bare 404 — including HEAD and GET, which have no
    # business here and whose absence is itself a small piece of hardening.
    def do_GET(self):
        self._refuse(404, "not found")

    def do_HEAD(self):
        self._refuse(404, "not found")

    def do_PUT(self):
        self._refuse(404, "not found")

    def do_POST(self):
        if self.path != "/v1/diag":
            return self._refuse(404, "not found")
        # AUTH FIRST, before a single byte of body is read: an unauthenticated caller must not be
        # able to make this process read four megabytes.
        auth = self.headers.get("Authorization", "")
        want = "Bearer " + self.server.secret
        if not hmac.compare_digest(auth, want):
            return self._refuse(401, "unauthorised")
        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            return self._refuse(411, "content-length required")
        if length <= 0 or length > MAX_BODY:
            return self._refuse(413, "body too large")
        with self.server.lock:
            now = time.time()
            if self.server.uploads >= MAX_UPLOADS:
                return self._refuse(429, "session upload limit reached")
            if now - self.server.last_at < MIN_UPLOAD_GAP_S:
                return self._refuse(429, "too fast")
            self.server.last_at = now
        body = self.rfile.read(length)
        if len(body) != length:
            return self._refuse(400, "short body")
        encoding = self.headers.get("Content-Encoding", "identity")
        try:
            text = gzip.decompress(body) if encoding == "gzip" else body
        except OSError:
            return self._refuse(400, "body is not gzip")
        seq, path = self._file(text)
        with self.server.lock:
            self.server.uploads += 1
        self.log_message("upload seq=%s %d bytes (%s) -> %s", seq, len(body), encoding,
                         os.path.basename(path))
        out = json.dumps({"ok": True, "seq": seq}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)

    def _file(self, text: bytes) -> tuple[str, str]:
        """Store the decompressed document, gzipped, under a sortable name. Returns (seq, path)."""
        os.makedirs(UPLOAD_DIR, exist_ok=True)
        seq = "?"
        try:
            seq = str(json.loads(text.split(b"\n", 1)[0]).get("seq", "?"))
        except (ValueError, IndexError):
            pass
        n = len([f for f in os.listdir(UPLOAD_DIR) if f.endswith(".jsonl.gz")]) + 1
        path = os.path.join(UPLOAD_DIR, f"{n:04d}-{int(time.time())}.jsonl.gz")
        with gzip.open(path, "wb") as f:
            f.write(text)
        return seq, path


def serve(args) -> int:
    """The background half of `start`. Not meant to be typed by hand."""
    st = _state()
    if not st:
        print("no session", file=sys.stderr)
        return 1
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(st["cert"], st["key"])
    srv = Receiver(("0.0.0.0", st["local_port"]), Handler, st["secret"], st["session"])
    srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
    st["local_port"] = srv.server_address[1]
    st["pid"] = os.getpid()
    st["started_at"] = time.time()

    mapped = False
    igd = None
    if not st.get("no_upnp"):
        igd = Upnp.discover()
        if igd:
            mapped = igd.add(st["port"], lan_ip(), st["local_port"], UPNP_LEASE_S)
            st["external_ip"] = igd.external_ip()
    if st.get("no_upnp"):
        st["upnp"] = "skipped"          # asked for; the operator owns the mapping
    else:
        st["upnp"] = "mapped" if mapped else ("no IGD found" if not igd else "refused by router")
    st["status"] = "listening"
    _write_state(st)

    def teardown(*_):
        # Every exit path, so the port stops being exposed the moment the receiver does: normal
        # stop, SIGTERM from `plxnative-lab stop`, and Ctrl-C.
        if mapped and igd:
            igd.delete(st["port"])
        s = _state()
        s["status"] = "stopped"
        s["upnp"] = "removed" if mapped else s.get("upnp", "none")
        s.pop("pid", None)
        _write_state(s)
        sys.exit(0)

    signal.signal(signal.SIGTERM, teardown)
    signal.signal(signal.SIGINT, teardown)

    def renew():
        while mapped and igd:
            time.sleep(UPNP_LEASE_S / 2)
            igd.add(st["port"], lan_ip(), st["local_port"], UPNP_LEASE_S)

    if mapped:
        threading.Thread(target=renew, daemon=True).start()
    try:
        srv.serve_forever()
    finally:
        teardown()
    return 0


