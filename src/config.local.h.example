/* Copy this file to config.local.h and fill in your Plex Media Server host and
 * X-Plex-Token. config.local.h is gitignored so your token never gets committed.
 * These override the placeholders in main.c. Find a token in Plex → any item →
 * Get Info → View XML. */
#define PMS_HOST  "YOUR_PMS_HOST"
#define PMS_PORT  32400
#define PMS_TOKEN "YOUR_PLEX_TOKEN"
/* Fallback demo part played if the library fetch is unavailable. */
#define DEMO_STREAM_URL "http://YOUR_PMS_HOST:32400/library/parts/0/0/file.mkv?X-Plex-Token=YOUR_PLEX_TOKEN"
